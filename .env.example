# ————— Roomie 环境变量清单（示例，真实值放 .env.local / Vercel）—————
# 详细说明见 docs/phase2-runbook.md

# Stripe（服务端专用）
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook 签名密钥：本地开发由 `stripe listen` 输出；生产由 scripts/stripe-setup.mjs 创建 endpoint 时输出
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase（服务端专用，绕过 RLS）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# 仅本地跑 `npm run db:migrate` 需要（数据库直连密码），Vercel 不配置
SUPABASE_DB_PASSWORD=xxx

# Resend 邮件（未配置时邮件层静默降级，下单流程不受影响）
RESEND_API_KEY=re_xxx
# 域名验证前只能用 onboarding@resend.dev（只能发给 Resend 账户本人邮箱）
RESEND_FROM=RoomiePaw <onboarding@resend.dev>

# 站点对外地址：本地 http://localhost:3000，生产 https://roomiepaw.vercel.app
NEXT_PUBLIC_URL=http://localhost:3000

# /api/shipping 内部接口鉴权（openssl rand -hex 24 生成）。
# 也是本地 admin 后台（npm run admin）的登录口令——本地与 Vercel 必须同值，
# 否则 admin 发货打生产会 401
ADMIN_SECRET=xxx

# 可选（仅 admin 用）：发货 API 目标。默认打生产；本地联调可设
# http://localhost:3000（同一个 Supabase/Resend，功能等价）
# SHIPPING_API_ORIGIN=

# 可选：Stripe Dashboard 配好 Stripe Tax（澳洲 GST）后设为 1，结算页启用自动计税
STRIPE_TAX_ENABLED=0
