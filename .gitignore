/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js
/.next/
/.next-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Roomie specifics
# ---------------------------------------------------------------------------

# Supplier working files — internal only, must never be published
/GlugGlug30天发文计划/
/Glug视频/

# Local social-content studio — drafts, generated media, reports, tokens,
# review state and third-party marketing skills. Intentionally never shipped.
/roomie-social-studio-local/

# Asset-pipeline scratch renders + intermediates.
# These are regenerated on every `tools/make_artworks.py` run; only the
# scripts and the source frame (last-frame.png) belong in version control.
/tools/*.png
/tools/*.npy
!/tools/last-frame.png

# admin（本地管理后台，独立 Next 应用）
/admin/node_modules
/admin/.next/
/admin/next-env.d.ts
/admin/tsconfig.tsbuildinfo

# Claude Code marketing studio (batch content, vendor recuts, reports).
# Local working area only, never shipped with the site.
/roomie-marketing/
